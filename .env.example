# ===== 应用 =====
APP_NAME=rag-knowledge
LOG_LEVEL=INFO

# ===== 数据库（与 docker-compose.yml 对应）=====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# ===== 腾讯云 COS（对象存储，按需填写）=====
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_HOST=

# ===== 跨域来源（逗号分隔，如 http://localhost:5173）=====
CORS_ORIGINS=
