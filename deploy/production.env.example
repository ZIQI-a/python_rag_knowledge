# 复制到服务器 /opt/rag-kb/.env，再填写实际值；不要提交真实 .env。
APP_NAME=rag-knowledge
LOG_LEVEL=INFO

# 三处数据库名称 / 用户保持不变，仅替换下面两处同一个密码。
# 容器内用服务名 postgres 和内部端口 5432，不用 localhost。
POSTGRES_USER=rag
POSTGRES_DB=rag_kb
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://rag:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/rag_kb

# Redis 没有宿主机映射端口，只有同一编排中的容器能够连接。
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
DEFAULT_ADMIN_DISPLAY_NAME=管理员

# Pages 反代让浏览器保持同源；填写正式前端域名，预览域名按需追加。
CORS_ORIGINS=https://rag.qiyuya.top

# 以下复制本地已经验证成功的配置，不要填 localhost。
AI_BASE_URL=https://REPLACE_WITH_MODEL_API/v1
AI_API_KEY=REPLACE_WITH_AI_API_KEY
CHAT_MODEL_NAME=REPLACE_WITH_CHAT_MODEL
EMBEDDING_MODEL=REPLACE_WITH_EMBEDDING_MODEL
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

COS_SECRET_ID=REPLACE_WITH_COS_SECRET_ID
COS_SECRET_KEY=REPLACE_WITH_COS_SECRET_KEY
COS_REGION=REPLACE_WITH_COS_REGION
COS_BUCKET=REPLACE_WITH_COS_BUCKET

QUERY_ROUTE_ENABLED=true
AGENT_LOOP_ENABLED=true
AGENT_MAX_ROUNDS=3
VERIFY_ANSWER_ENABLED=true
RERANK_ENABLED=true
RERANK_BASE_URL=https://REPLACE_WITH_RERANK_API
RERANK_MODEL=REPLACE_WITH_RERANK_MODEL
# 留空时使用 AI_API_KEY；独立密钥则在这里填写。
RERANK_API_KEY=

UPLOAD_MAX_SIZE_MB=10
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# 如需追踪，填写密钥后改为 true；不影响问答基础功能。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-knowledge-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_RUN_URL_PREFIX=
